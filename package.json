{
  "name": "simonheys",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "concurrently -k -r \"tsx ./src/scripts/generate-content --watch\" \"tsx ./src/scripts/generate-icon-components --watch\" \"tsx ./src/scripts/generate-image-properties --watch\" \"next dev\"",
    "build": "tsx ./src/scripts/generate-content && tsx ./src/scripts/generate-image-properties && tsx ./src/scripts/generate-icon-components && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "verify": "eslint . --max-warnings=0 && jest && tsx ./src/scripts/generate-content && tsx ./src/scripts/generate-image-properties && tsx ./src/scripts/generate-icon-components && next build",
    "generate": "tsx ./src/scripts/generate-content && tsx ./src/scripts/generate-image-properties && tsx ./src/scripts/generate-icon-components",
    "generate:content": "tsx ./src/scripts/generate-content",
    "generate:favicon": "tsx ./src/scripts/generate-favicon",
    "generate:icon-components": "tsx ./src/scripts/generate-icon-components",
    "generate:image-properties": "tsx ./src/scripts/generate-image-properties",
    "generate:watch": "concurrently -k -r \"tsx ./src/scripts/generate-content --watch\" \"tsx ./src/scripts/generate-icon-components --watch\" \"tsx ./src/scripts/generate-image-properties --watch\"",
    "format": "prettier --write \"./**/*.{js,json,css,scss,yml,ts,tsx}\"",
    "test": "jest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@simonheys/wordclock": "1.3.0",
    "@simonheys/wordclock-words": "1.2.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vimeo/player": "2.30.4",
    "clsx": "2.1.1",
    "colord": "2.9.3",
    "favicons": "7.2.0",
    "feed": "5.2.1",
    "framer-motion": "12.38.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-utils": "2.5.2",
    "next": "16.2.6",
    "popmotion": "11.0.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-intersection-observer": "10.0.3",
    "react-markdown": "10.1.0",
    "resize-observer-polyfill": "1.5.1",
    "swr": "2.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.59.1",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-prettier": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/node22": "22.0.5",
    "@types/cli-progress": "3.11.6",
    "@types/fs-extra": "11.0.4",
    "@types/get-pixels": "3.3.4",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/ndarray": "1.0.14",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/resize-observer-browser": "0.1.11",
    "@types/vimeo__player": "2.18.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "chokidar": "5.0.0",
    "cli-progress": "3.12.0",
    "concurrently": "9.2.1",
    "eslint": "10.3.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fs-extra": "11.3.5",
    "get-pixels": "3.3.3",
    "graphology-types": "0.24.8",
    "husky": "9.1.7",
    "image-size": "2.0.2",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "js-yaml": "4.1.1",
    "lint-staged": "17.0.4",
    "minimist": "1.2.8",
    "postcss": "8.5.14",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rimraf": "6.1.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.22.0",
    "typescript": "6.0.3"
  },
  "main": "index.js",
  "repository": "git@github.com:simonheys/simonheys.com.git",
  "author": "Simon Heys <si@simonheys.com>",
  "license": "MIT",
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14"
    }
  }
}
